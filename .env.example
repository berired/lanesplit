# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Neon Postgres connection string (pooled connection recommended for the app runtime).
# Get this from your Neon project dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign/verify JWT session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Shared secret required as a header on the weekly-scoring cron endpoint.
CRON_SECRET="replace-with-a-long-random-secret"

# Riot Games Developer API key (https://developer.riotgames.com/). Dev keys expire every 24h.
RIOT_API_KEY=""
